# CoursePulse local development environment
# Copy this file to .env in this directory (files/.env).
# Replace the local-only password before starting Docker Compose.
# Never put real production secrets in this file or commit a populated .env.

# Required by the current Next.js runtime environment validator.
SITE_URL=http://localhost:3000
TRUSTED_ORIGINS=

# Required only for the local PostgreSQL Docker Compose service.
# This is a local development password, not a production credential.
LOCAL_DB_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_LOCAL_PASSWORD

# The variables below are optional in the current Phase 3 runtime.
# They become required when their respective integrations are implemented.
# Do not set empty values; leave unused variables commented out.

# Database runtime roles (Phase 5; use distinct PostgreSQL roles and TLS in production).
# DATABASE_URL=postgresql://cp_app:REPLACE_ME@localhost:5432/coursepulse?sslmode=disable
# DATABASE_URL_AUTH=postgresql://cp_auth:REPLACE_ME@localhost:5432/coursepulse?sslmode=disable
# DATABASE_URL_MAINT=postgresql://cp_maint:REPLACE_ME@localhost:5432/coursepulse?sslmode=disable
# DATABASE_URL_MIGRATE=postgresql://cp_owner:REPLACE_ME@localhost:5432/coursepulse?sslmode=disable

# Authentication and scheduled maintenance secrets (Phase 4+).
# Generate each value independently with: openssl rand -base64 48
# AUTH_SECRET=
# CRON_SECRET=
# RATE_LIMIT_KEY_SECRET=

# Optional integrations (later phases).
# EMAIL_API_KEY=
# EMAIL_FROM=
# RATE_LIMIT_REDIS_URL=rediss://...
# RATE_LIMIT_REDIS_TOKEN=
# TURNSTILE_SECRET_KEY=

# Only these public variable names are allow-listed by the current environment guard.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# NEXT_PUBLIC_ANALYTICS_DOMAIN=
# NEXT_PUBLIC_CONTACT_EMAIL=
# NEXT_PUBLIC_CONTACT_PHONE=

# Keep false for local work. Production startup rejects true.
# DEV_DISABLE_RATE_LIMIT=false
