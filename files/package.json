{
  "name": "coursepulse",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "CoursePulse \u2014 Smart Course Feedback & Analytics Portal",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:conventions": "node scripts/check-conventions.mjs && node scripts/check-conventions.mjs --self-test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:security": "vitest run tests/security",
    "test:e2e": "playwright test",
    "check:unused": "knip",
    "audit:deps": "pnpm audit --audit-level=high",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "next": "^16.4.1",
    "react": "^19.2.9",
    "react-dom": "^19.2.9",
    "server-only": "^0.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.4.1",
    "knip": "^5.0.0",
    "lefthook": "^1.13.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver",
      "lefthook"
    ]
  }
}
