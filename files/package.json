{
  "name": "coursepulse",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "CoursePulse — Smart Course Feedback & Analytics Portal",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:conventions": "node check-conventions.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:security": "vitest run csp.test.ts headers.test.ts origin-check.test.ts request-policy.test.ts env-guards.test.ts env.test.ts",
    "test:e2e": "playwright test",
    "check:unused": "knip",
    "audit:deps": "pnpm audit --audit-level=high",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "next": "^16.4.1",
    "react": "^19.2.9",
    "react-dom": "^19.2.9",
    "server-only": "^0.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.4.1",
    "knip": "^5.0.0",
    "lefthook": "^1.13.0",
    "postcss": "^8.5.32",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  },
  "packageManager": "pnpm@12.16.1"
}
